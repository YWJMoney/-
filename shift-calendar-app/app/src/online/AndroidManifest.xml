<?xml version="1.0" encoding="utf-8"?>
<!-- [MKT-09] Only builds with a link sharing server (bamnat.shareBaseUrl) ask for the internet:
     a build with that property blank stays fully offline. Privacy policy 1.4 covers the link server. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
