<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [MKT-09] Only for read-only schedule links the user makes; nothing else goes online. -->
    <!-- Android 12: exact alarms. Android 13+: USE_EXACT_ALARM, allowed for calendar/alarm apps. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- [SLP-08] Read only: sleep sessions a watch or the phone wrote to Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- [IMPORT-01] Read only, asked when the user opens 캘린더에서 가져오기; nothing read leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- [FEAT-07] 휴대폰 캘린더에 근무 쓰기 (프로): asked only when the user turns it on. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- [DAYW-07] 출퇴근 자동 기록 only, off by default and asked when the user turns it on after a plain
         explanation: one geofence around the workplace, used on the phone; no location is sent or kept. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- [LOCK-01] 앱 잠금 only, off by default: the phone's own fingerprint/face/PIN prompt. The app never
         sees the fingerprint or face; Android only says whether it matched. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".BamnatApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bamnat.Starting"
        android:enableOnBackInvokedCallback="true">

        <!-- [MON-07] AdMob app id (gradle.properties bamnat.admobAppId; Google's sample id when blank).
             No ad is asked for before the 정식 출시 switch, for 프로, or without ad unit ids. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- [MON-07] The ads SDK starts its measurement only when MobileAds.initialize runs (Ads.startSdk: after the
             정식 출시 switch and Google's consent), not at every app start. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- resizeableActivity + configChanges keep state smooth when a Fold opens or closes.
             singleTop: a shared calendar link tapped while the app is open comes to onNewIntent [SHR-02]. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".alarm.AlarmActivity"
            android:directBootAware="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Bamnat" />

        <!-- [OPS-10] An alarm app holding USE_EXACT_ALARM rings as systemExempted on Android 14+, and
             older versions need no type, so no mediaPlayback (and no Play media playback declaration).
             [REL-10] directBootAware: rings before the first unlock. -->
        <service
            android:name=".alarm.AlarmService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- [REL-12] 끄기·다시 울림 from the lock screen notification; [SLP-15] 지금 끄기 for a waiting snooze. -->
        <receiver
            android:name=".alarm.AlarmActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- [REL-10] After a reboot, before the first unlock: alarms come back from the device-protected copy. -->
        <receiver
            android:name=".alarm.LockedBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".money.JobReminderReceiver"
            android:exported="false" />

        <!-- [SCHED-01] A memo that is a schedule: its notice or its alarm at that minute. -->
        <receiver
            android:name=".memo.MemoScheduleReceiver"
            android:exported="false" />

        <!-- [INV-08] The investor's 장 시작·마감, 정기 매수일, 목표가 알람 and 바로 기록 from its notice. -->
        <receiver
            android:name=".invest.InvestAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".invest.InvestActionReceiver"
            android:exported="false" />

        <!-- [PAY-12][REL-08] 연차 lapse notice on 11/1 and 12/1. -->
        <receiver
            android:name=".pay.LeaveReminderReceiver"
            android:exported="false" />

        <!-- [MON-06] The trial's question, 7 days before it turns paid. -->
        <receiver
            android:name=".tier.TrialNoticeReceiver"
            android:exported="false" />

        <!-- [SHR-12] The shared link closing soon, and its 늘리기 button. -->
        <receiver
            android:name=".share.ShareExpiryReceiver"
            android:exported="false" />
        <receiver
            android:name=".share.ShareExtendReceiver"
            android:exported="false" />

        <!-- [SLP-15] 하루 브리핑, 퇴근길 안전 and 잘 준비; the name stays from 1.10 so its alarms still land. -->
        <receiver
            android:name=".sleep.SleepReminderReceiver"
            android:exported="false" />

        <!-- [SLP-15] 잠들었어요·깼어요 on a notice, usable from the lock screen. -->
        <receiver
            android:name=".sleep.SleepActionReceiver"
            android:exported="false" />

        <!-- [SLP-15] Money and 연차 notices held while the user sleeps come 30 minutes after waking. -->
        <receiver
            android:name=".sleep.QuietHoldReceiver"
            android:exported="false" />

        <!-- [LEDG-02] Payment notifications. Off until the user turns it on in the app and grants
             notification access; only texts with an amount and a payment word are read. -->
        <service
            android:name=".money.CaptureService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- [DAYW-07] Workplace geofence crossings and 맞아요·아니요 on the record's notice. Location turned
             back on (PROVIDERS_CHANGED) no longer reaches a manifest receiver; CommuteRecorder listens for it
             while the feature is on, and an inexact check every 12 hours (CHECK) catches what it missed. -->
        <receiver
            android:name=".commute.CommuteReceiver"
            android:exported="false" />

        <!-- [SHFT-08] The Wear OS app asks for fresh days when it opens; only Google Play services binds it. -->
        <service
            android:name=".watch.WatchRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/bamnat/sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>

        <receiver
            android:name=".widget.MidnightReceiver"
            android:exported="false" />
        <!-- [SLP-08] Health Connect shows this from its permission screen (Android 13 and older). -->
        <activity
            android:name=".sleep.HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Bamnat">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- [SLP-08] The same page on Android 14 and newer, where Health Connect is part of the system. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".sleep.HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
